# ── Skyra Vision Service Environment Configuration ─────────────────────
# Copy this file to .env and fill in your values. DO NOT commit .env to Git.

# ── Server ──────────────────────────────────────────────────────────────
PORT=8006

# ── Gemini Vision API Keys ───────────────────────────────────────────────
# Provide at least one Gemini API key with vision capabilities
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# ── Telegram Out-of-Band Alert Configuration ─────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_personal_chat_id

# ── Hotkey Trigger Configuration ─────────────────────────────────────────
# Combination to trigger silent screen capture and analysis
HOTKEY_COMBINATION=ctrl+shift+f9
